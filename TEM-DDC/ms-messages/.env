# Server
PORT=3060
NODE_ENV=development

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=messages

# Optional
DB_SYNC=true
DB_LOGGING=false

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3045,http://localhost:5173,http://localhost:5174

# WebSocket
WS_CORS_ORIGIN=*
