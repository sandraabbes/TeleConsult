# Server
PORT=3050
NODE_ENV=development

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=video_consultation

# Optional
DB_SYNC=true
DB_LOGGING=false

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3045

# JWT (for auth guards - set in production)
JWT_SECRET=your-jwt-secret-change-in-production
JWT_EXPIRES_IN=1h

# WebSocket
WS_CORS_ORIGIN=*

# Notifications MS (TCP)
NOTIFICATIONS_SERVICE_HOST=localhost
NOTIFICATIONS_SERVICE_PORT=4005
